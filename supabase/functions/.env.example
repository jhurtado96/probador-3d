# Copia este fichero a supabase/functions/.env (no se versiona) para
# `supabase functions serve`. En la nube: `supabase secrets set NOMBRE=valor`.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.

# Secretos HMAC compartidos con los workers GPU, uno por sentido, 32+ bytes aleatorios cada uno.
# Llevan el mismo nombre en el worker (services/workers). Formato de la firma: packages/contracts.
# Firma de los callbacks que llegan a job-callback (worker -> API).
PROBADOR_CALLBACK_SECRET=
# Firma del JobDispatch que se envía al worker (API -> worker). Sin él no se despacha.
PROBADOR_DISPATCH_SECRET=
# Secreto que pg_cron envía a la función maintenance (el mismo valor va a Vault como maintenance_secret).
MAINTENANCE_SECRET=

# Endpoint web del worker en Modal (región UE) que recibe JobDispatch.
# Vacío = los jobs se quedan en cola sin despachar (útil en local sin GPU).
WORKER_DISPATCH_URL=

# Opcionales
# 1 = aceptar callbacks de workers en modo fake (JobCallback.fake). Solo en desarrollo; nunca en producción.
PROBADOR_ALLOW_FAKE_WORKERS=
# URL pública de job-callback que se envía al worker (por defecto ${SUPABASE_URL}/functions/v1/job-callback).
JOB_CALLBACK_URL=
# Sustituye el origen de las URLs firmadas que recibe el worker (solo en local: SUPABASE_URL es http://kong:8000).
PUBLIC_SUPABASE_URL=
# Jobs por usuario y 24 h (por defecto 50).
JOB_DAILY_QUOTA=50
# Exportaciones de datos (export-data) por usuario y 24 h (por defecto 5).
DATA_EXPORT_DAILY_QUOTA=5
# Versión del simulador de tela; entra en la clave de caché del drapeado.
DRAPE_SIMULATOR_VERSION=drape-sim-0

# Secreto del seudónimo de los consentimientos archivados (D6): NO va en este fichero.
# Vive en Vault de Postgres, porque el HMAC lo calcula el trigger de archivo dentro de la base
# de datos y así el secreto nunca sale de Postgres. Una vez por entorno, 32+ caracteres aleatorios:
#   select vault.create_secret('<valor>', 'consent_pseudonym_secret');
# Sin él, delete-account responde 500 y no borra nada. No se puede rotar sin perder la
# correspondencia con los registros ya archivados: guardarlo también fuera de la base de datos.
# CONSENT_PSEUDONYM_SECRET (en Vault: consent_pseudonym_secret)
