{
  "expo": {
    "name": "Probador 3D",
    "slug": "probador-3d",
    "version": "0.1.0",
    "scheme": "probador",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.probador.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.probador.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Probador 3D necesita acceder a tus fotos para que elijas una foto de cuerpo entero o de una prenda. Solo se sube la foto que elijas y se borra tras procesarla.",
          "cameraPermission": "Probador 3D usa la cámara para hacer la foto de cuerpo entero o de una prenda. La foto se borra tras procesarla.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
