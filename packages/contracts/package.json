{
  "name": "@probador/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Tipos y JSON Schemas compartidos entre la app Expo, la API y los workers Python del probador virtual 3D",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "schemas",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "schemas": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "test": "npm run typecheck && npm run schemas:check"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2"
  }
}
