{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/UUID",
      "description": "Igual al id del usuario de Auth."
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "age_confirmed_at": {
      "anyOf": [
        {
          "$ref": "#/definitions/ISODateTime"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cuándo declaró cumplir la edad mínima; no se guarda la fecha de nacimiento."
    },
    "created_at": {
      "$ref": "#/definitions/ISODateTime"
    },
    "updated_at": {
      "$ref": "#/definitions/ISODateTime"
    }
  },
  "required": [
    "id",
    "display_name",
    "locale",
    "age_confirmed_at",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "description": "Perfil mínimo del usuario (tabla `profiles`). Se crea al darse de alta.",
  "definitions": {
    "UUID": {
      "type": "string",
      "description": "Identificador UUID.",
      "format": "uuid"
    },
    "ISODateTime": {
      "type": "string",
      "description": "Fecha y hora ISO 8601 en UTC.",
      "format": "date-time"
    }
  },
  "$id": "https://probador.app/schemas/profile.schema.json",
  "title": "Profile"
}
