  "additionalProperties": false,
  "description": "Preferencias de fit del usuario (tabla `user_fit_preferences`, una fila por usuario).",
  "definitions": {
    "UUID": {
      "type": "string",
      "description": "Identificador UUID.",
      "format": "uuid"
    },
    "DesignFit": {
      "type": "string",
      "enum": [
        "slim",
        "regular",
        "relaxed",
        "oversize"
      ],
      "description": "Fit con el que se diseñó la prenda (no confundir con llevar una talla mayor)."
    },
    "EasePreference": {
      "type": "object",
      "properties": {
        "preferred_cm": {
          "type": "number",
          "description": "Holgura objetivo μ, en cm."
        },
        "tolerance_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Tolerancia σ, en cm."
        },
        "observations": {
          "type": "integer",
          "description": "Opiniones que la respaldan (la prenda favorita cuenta como 3).",
          "minimum": 0
        }
      },
      "required": [
        "preferred_cm",
        "tolerance_cm",
        "observations"
      ],
      "additionalProperties": false,
      "description": "Holgura preferida en una zona (`docs/research/fit.md` §6)."
    },
    "Centimeters": {
      "type": "number",
      "description": "Longitud en centímetros.",
      "minimum": 0
    },
    "ISODateTime": {
      "type": "string",
      "description": "Fecha y hora ISO 8601 en UTC.",
      "format": "date-time"
    }
  },
  "$id": "https://probador.app/schemas/user_fit_preferences.schema.json",
  "title": "UserFitPreferences"
