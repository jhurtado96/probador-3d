{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/UUID"
    },
    "user_id": {
      "$ref": "#/definitions/UUID",
      "description": "Dueño del avatar."
    },
    "avatar_id": {
      "$ref": "#/definitions/UUID"
    },
    "garment_id": {
      "$ref": "#/definitions/UUID"
    },
    "size_label": {
      "type": "string"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ZoneFit"
      },
      "minItems": 1
    },
    "verdict": {
      "$ref": "#/definitions/FitVerdict"
    },
    "effective_fit": {
      "$ref": "#/definitions/DesignFit",
      "description": "Cómo queda de verdad en este cuerpo, que puede no coincidir con `design_fit`."
    },
    "matches_design_fit": {
      "type": "boolean",
      "description": "`false` cuando, p. ej., un oversize de diseño queda regular o una talla mayor finge oversize."
    },
    "size_offset": {
      "type": [
        "number",
        "null"
      ],
      "description": "Tallas de más (positivo) o de menos (negativo) respecto a la suya, medido en las zonas ancla (s_A de `docs/research/fit.md`). Distingue «talla mayor» de «oversize de diseño»."
    },
    "score": {
      "$ref": "#/definitions/UnitInterval",
      "description": "Ajuste respecto a las preferencias del usuario; entra en el ranking con peso 0,3."
    },
    "recommended_size_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Talla recomendada si no es `size_label`."
    },
    "method": {
      "$ref": "#/definitions/FitMethod"
    },
    "confidence": {
      "$ref": "#/definitions/UnitInterval"
    },
    "created_at": {
      "$ref": "#/definitions/ISODateTime"
    }
  },
  "required": [
    "id",
    "user_id",
    "avatar_id",
    "garment_id",
    "size_label",
    "zones",
    "verdict",
    "effective_fit",
    "matches_design_fit",
    "score",
    "method",
    "confidence",
    "created_at"
  ],
  "additionalProperties": false,
  "description": "Resultado de ajuste de una prenda y talla sobre un avatar: cómo le queda a ESTA persona. El fit de diseño es otra cosa y vive en `Garment.design_fit`.",
  "definitions": {
    "UUID": {
      "type": "string",
      "description": "Identificador UUID.",
      "format": "uuid"
    },
    "ZoneFit": {
      "type": "object",
      "properties": {
        "zone": {
          "$ref": "#/definitions/FitZone"
        },
        "body_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "garment_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "ease_cm": {
          "type": "number",
          "description": "`garment_cm · (1 + stretch) − body_cm` en contornos, `garment_cm − body_cm` en largos; negativo si la prenda es más pequeña que el cuerpo."
        },
        "ease_sigma_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Incertidumbre (1σ) de `ease_cm`: √(σ_cuerpo² + σ_prenda²). La app muestra la holgura como banda cuando existe."
        },
        "verdict": {
          "$ref": "#/definitions/ZoneVerdict",
          "description": "Veredicto más probable."
        },
        "verdict_probabilities": {
          "type": "object",
          "properties": {
            "too_tight": {
              "$ref": "#/definitions/UnitInterval"
            },
            "snug": {
              "$ref": "#/definitions/UnitInterval"
            },
            "ideal": {
              "$ref": "#/definitions/UnitInterval"
            },
            "loose": {
              "$ref": "#/definitions/UnitInterval"
            },
            "too_loose": {
              "$ref": "#/definitions/UnitInterval"
            },
            "too_short": {
              "$ref": "#/definitions/UnitInterval"
            },
            "too_long": {
              "$ref": "#/definitions/UnitInterval"
            }
          },
          "additionalProperties": false,
          "description": "Probabilidad de cada veredicto dada la incertidumbre; suman 1."
        }
      },
      "required": [
        "zone",
        "body_cm",
        "garment_cm",
        "ease_cm",
        "verdict"
      ],
      "additionalProperties": false,
      "description": "Holgura en una zona: medida de la prenda menos medida del cuerpo."
    },
    "FitZone": {
      "type": "string",
      "enum": [
        "neck",
        "shoulder",
        "chest",
        "waist",
        "hip",
        "sleeve_length",
        "bicep",
        "cuff",
        "body_length",
        "thigh",
        "knee",
        "inseam",
        "rise",
        "hem"
      ],
      "description": "Zona de medida compartida entre prenda y fit. En contornos (`chest`, `waist`, `hip`, `neck`, `bicep`, `cuff`, `thigh`, `knee`, `hem`) la medida de la prenda es el perímetro completo, no el ancho en plano."
    },
    "Centimeters": {
      "type": "number",
      "description": "Longitud en centímetros.",
      "minimum": 0
    },
    "ZoneVerdict": {
      "type": "string",
      "enum": [
        "too_tight",
        "snug",
        "ideal",
        "loose",
        "too_loose",
        "too_short",
        "too_long"
      ]
    },
    "UnitInterval": {
      "type": "number",
      "description": "Valor normalizado entre 0 y 1.",
      "minimum": 0,
      "maximum": 1
    },
    "FitVerdict": {
      "type": "string",
      "enum": [
        "too_small",
        "fits",
        "too_large"
      ],
      "description": "Veredicto global de la talla sobre este cuerpo."
    },
    "DesignFit": {
      "type": "string",
      "enum": [
        "slim",
        "regular",
        "relaxed",
        "oversize"
      ],
      "description": "Fit con el que se diseñó la prenda (no confundir con llevar una talla mayor)."
    },
    "FitMethod": {
      "type": "string",
      "enum": [
        "size_chart",
        "measured",
        "simulated"
      ]
    },
    "ISODateTime": {
      "type": "string",
      "description": "Fecha y hora ISO 8601 en UTC.",
      "format": "date-time"
    }
  },
  "$id": "https://probador.app/schemas/fit_result.schema.json",
  "title": "FitResult"
}
