{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "job_id": {
      "$ref": "#/definitions/UUID"
    },
    "attempt": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed"
      ]
    },
    "progress": {
      "$ref": "#/definitions/UnitInterval"
    },
    "stage": {
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/definitions/AvatarJobOutput"
        },
        {
          "$ref": "#/definitions/GarmentJobOutput"
        },
        {
          "$ref": "#/definitions/DrapeJobOutput"
        },
        {
          "$ref": "#/definitions/ColorJobOutput"
        }
      ]
    },
    "error": {
      "$ref": "#/definitions/JobError"
    },
    "worker_version": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "attempt",
    "status",
    "worker_version"
  ],
  "additionalProperties": false,
  "description": "Lo que el worker envía a `callback_url`, firmado con HMAC-SHA256 en la cabecera `x-probador-signature`. En `output`, los campos `*_url` de los artefactos que subió el worker van como `storage://<path de output_uploads>`; la API los convierte en rutas al persistir y en URLs firmadas al servir.",
  "definitions": {
    "UUID": {
      "type": "string",
      "description": "Identificador UUID.",
      "format": "uuid"
    },
    "UnitInterval": {
      "type": "number",
      "description": "Valor normalizado entre 0 y 1.",
      "minimum": 0,
      "maximum": 1
    },
    "AvatarJobOutput": {
      "type": "object",
      "properties": {
        "avatar": {
          "$ref": "#/definitions/Avatar"
        },
        "input_deleted_at": {
          "$ref": "#/definitions/ISODateTime",
          "description": "Momento en que se borró la foto de entrada."
        }
      },
      "required": [
        "avatar",
        "input_deleted_at"
      ],
      "additionalProperties": false,
      "description": "Salida del job `avatar`."
    },
    "Avatar": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/UUID"
        },
        "user_id": {
          "$ref": "#/definitions/UUID"
        },
        "body_model": {
          "$ref": "#/definitions/BodyModel"
        },
        "model_version": {
          "type": "string",
          "description": "Versión del modelo corporal y del pipeline, p. ej. `smplx-1.1/avatar-0.3`."
        },
        "smplx": {
          "$ref": "#/definitions/SmplxParams",
          "description": "Parámetros del modelo corporal (se llaman `smplx` aunque el modelo sea compatible)."
        },
        "measurements": {
          "$ref": "#/definitions/BodyMeasurements"
        },
        "measurements_source": {
          "$ref": "#/definitions/MeasurementSource"
        },
        "measurements_override": {
          "type": "object",
          "properties": {
            "height_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Altura declarada por el usuario; ancla la escala del avatar."
            },
            "chest_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Contorno de pecho en el punto más ancho."
            },
            "waist_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Contorno de cintura natural."
            },
            "hip_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Contorno de cadera en el punto más ancho."
            },
            "shoulder_width_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Ancho de hombros, de acromion a acromion por la espalda."
            },
            "arm_length_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Largo de brazo, de acromion a muñeca."
            },
            "inseam_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Entrepierna, de la ingle al suelo."
            },
            "neck_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "underbust_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "bicep_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "wrist_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "thigh_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "calf_cm": {
              "$ref": "#/definitions/Centimeters"
            },
            "torso_length_cm": {
              "$ref": "#/definitions/Centimeters",
              "description": "Largo de torso, de la séptima cervical a la cintura."
            },
            "weight_kg": {
              "type": "number",
              "description": "Peso declarado, opcional; mejora la estimación de forma.",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Medidas corregidas a mano por el usuario; prevalecen sobre `measurements`."
        },
        "glb_url": {
          "$ref": "#/definitions/Url",
          "description": "GLB del avatar en `pose`, en metros, Y arriba, pies en el origen."
        },
        "pose": {
          "$ref": "#/definitions/AvatarPose"
        },
        "shape_hash": {
          "type": "string",
          "description": "Cambia cuando cambia la forma; forma parte de la clave de caché del drapeado."
        },
        "confidence": {
          "$ref": "#/definitions/UnitInterval",
          "description": "Confianza global de la estimación."
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "updated_at": {
          "$ref": "#/definitions/ISODateTime"
        }
      },
      "required": [
        "id",
        "user_id",
        "body_model",
        "model_version",
        "smplx",
        "measurements",
        "measurements_source",
        "glb_url",
        "pose",
        "shape_hash",
        "confidence",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "description": "Avatar 3D del usuario. No contiene ni referencia la foto de origen."
    },
    "BodyModel": {
      "type": "string",
      "enum": [
        "smplx",
        "anny"
      ],
      "description": "Modelo corporal paramétrico. `anny` es la alternativa de licencia abierta."
    },
    "SmplxParams": {
      "type": "object",
      "properties": {
        "gender": {
          "$ref": "#/definitions/BodyModelGender"
        },
        "betas": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Coeficientes de forma.",
          "minItems": 10,
          "maxItems": 300
        },
        "body_pose": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Pose corporal en eje-ángulo, 21 articulaciones × 3. Opcional.",
          "minItems": 63,
          "maxItems": 63
        },
        "expression": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Coeficientes de expresión facial. Opcional.",
          "maxItems": 100
        }
      },
      "required": [
        "gender",
        "betas"
      ],
      "additionalProperties": false,
      "description": "Parámetros del modelo corporal. Con `betas` y `gender` basta para reconstruir la forma; la pose de la foto se descarta y el avatar se entrega en la pose canónica."
    },
    "BodyModelGender": {
      "type": "string",
      "enum": [
        "neutral",
        "female",
        "male"
      ]
    },
    "BodyMeasurements": {
      "type": "object",
      "properties": {
        "height_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Altura declarada por el usuario; ancla la escala del avatar."
        },
        "chest_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Contorno de pecho en el punto más ancho."
        },
        "waist_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Contorno de cintura natural."
        },
        "hip_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Contorno de cadera en el punto más ancho."
        },
        "shoulder_width_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Ancho de hombros, de acromion a acromion por la espalda."
        },
        "arm_length_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Largo de brazo, de acromion a muñeca."
        },
        "inseam_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Entrepierna, de la ingle al suelo."
        },
        "neck_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "underbust_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "bicep_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "wrist_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "thigh_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "calf_cm": {
          "$ref": "#/definitions/Centimeters"
        },
        "torso_length_cm": {
          "$ref": "#/definitions/Centimeters",
          "description": "Largo de torso, de la séptima cervical a la cintura."
        },
        "weight_kg": {
          "type": "number",
          "description": "Peso declarado, opcional; mejora la estimación de forma.",
          "minimum": 0
        }
      },
      "required": [
        "height_cm",
        "chest_cm",
        "waist_cm",
        "hip_cm",
        "shoulder_width_cm",
        "arm_length_cm",
        "inseam_cm"
      ],
      "additionalProperties": false,
      "description": "Medidas del cuerpo en cm. Los contornos son perímetros completos. Las obligatorias son las que el fit del MVP necesita; el resto depende del método de medición."
    },
    "Centimeters": {
      "type": "number",
      "description": "Longitud en centímetros.",
      "minimum": 0
    },
    "MeasurementSource": {
      "type": "string",
      "enum": [
        "photo",
        "photo_reference_object",
        "lidar",
        "manual"
      ],
      "description": "Cómo se obtuvieron las medidas."
    },
    "Url": {
      "type": "string",
      "description": "URL https. Para objetos privados de Storage es una URL firmada que caduca: no se persiste en cliente más allá de la sesión.",
      "format": "uri"
    },
    "AvatarPose": {
      "type": "string",
      "enum": [
        "a_pose",
        "t_pose",
        "relaxed"
      ]
    },
    "ISODateTime": {
      "type": "string",
      "description": "Fecha y hora ISO 8601 en UTC.",
      "format": "date-time"
    },
    "GarmentJobOutput": {
      "type": "object",
      "properties": {
        "garment": {
          "$ref": "#/definitions/Garment"
        },
        "input_deleted_at": {
          "$ref": "#/definitions/ISODateTime",
          "description": "Momento en que se borraron las fotos originales (queda solo el recorte)."
        }
      },
      "required": [
        "garment",
        "input_deleted_at"
      ],
      "additionalProperties": false,
      "description": "Salida del job `garment`."
    },
    "Garment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/UUID"
        },
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dueño. `null` en prendas de catálogo de tienda."
        },
        "store_product_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ],
          "description": "Producto de tienda del que procede, si lo hay."
        },
        "status": {
          "$ref": "#/definitions/GarmentStatus"
        },
        "category": {
          "$ref": "#/definitions/GarmentCategory"
        },
        "name": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "attributes": {
          "$ref": "#/definitions/GarmentAttributes"
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GarmentColor"
          },
          "description": "Colores dominantes, de mayor a menor proporción.",
          "minItems": 1
        },
        "design_fit": {
          "$ref": "#/definitions/DesignFit"
        },
        "size_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Talla que tiene el usuario (armario) o `null` si es de catálogo."
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GarmentSizeMeasurements"
          },
          "description": "Medidas por talla; en el armario suele haber una sola."
        },
        "level": {
          "$ref": "#/definitions/GarmentLevel"
        },
        "template_id": {
          "type": "string",
          "description": "Plantilla paramétrica usada (nivel 1)."
        },
        "image_url": {
          "$ref": "#/definitions/Url",
          "description": "Recorte de la prenda sin fondo ni persona. La foto original no se conserva."
        },
        "glb_url": {
          "anyOf": [
            {
              "$ref": "#/definitions/Url"
            },
            {
              "type": "null"
            }
          ],
          "description": "GLB de la prenda en reposo; `null` mientras `status` es `processing`."
        },
        "user_corrected_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Campos que el usuario corrigió a mano; el pipeline no los pisa."
        },
        "pipeline_version": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "updated_at": {
          "$ref": "#/definitions/ISODateTime"
        }
      },
      "required": [
        "id",
        "user_id",
        "status",
        "category",
        "attributes",
        "colors",
        "design_fit",
        "size_label",
        "measurements",
        "level",
        "image_url",
        "glb_url",
        "pipeline_version",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "description": "Prenda del armario del usuario o normalizada desde un producto de tienda."
    },
    "GarmentStatus": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "failed"
      ]
    },
    "GarmentCategory": {
      "type": "string",
      "enum": [
        "tshirt",
        "shirt",
        "sweater",
        "hoodie",
        "jacket",
        "coat",
        "dress",
        "skirt",
        "pants",
        "jeans",
        "shorts"
      ]
    },
    "GarmentAttributes": {
      "type": "object",
      "properties": {
        "pattern": {
          "$ref": "#/definitions/GarmentPattern"
        },
        "material": {
          "type": "string",
          "description": "Material principal en texto libre normalizado: `cotton`, `denim`, `wool`."
        },
        "sleeve_length": {
          "$ref": "#/definitions/SleeveLength"
        },
        "neckline": {
          "type": "string",
          "description": "`crew`, `v`, `collar`, `hood`…"
        },
        "length": {
          "$ref": "#/definitions/GarmentLength"
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Estaciones del año: `summer`, `winter`…"
        },
        "formality": {
          "type": "string",
          "description": "`casual`, `smart`, `formal`, `sport`."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Etiquetas libres."
        }
      },
      "additionalProperties": false,
      "description": "Atributos del etiquetado automático; todos corregibles por el usuario."
    },
    "GarmentPattern": {
      "type": "string",
      "enum": [
        "solid",
        "stripes",
        "checks",
        "floral",
        "print",
        "graphic",
        "other"
      ]
    },
    "SleeveLength": {
      "type": "string",
      "enum": [
        "sleeveless",
        "short",
        "three_quarter",
        "long"
      ]
    },
    "GarmentLength": {
      "type": "string",
      "enum": [
        "cropped",
        "regular",
        "long",
        "mini",
        "midi",
        "maxi"
      ]
    },
    "GarmentColor": {
      "type": "object",
      "properties": {
        "lab": {
          "$ref": "#/definitions/LabColor"
        },
        "hex": {
          "$ref": "#/definitions/HexColor",
          "description": "El mismo color en hex, para pintarlo."
        },
        "proportion": {
          "$ref": "#/definitions/UnitInterval",
          "description": "Fracción de la superficie visible que ocupa."
        },
        "name": {
          "type": "string",
          "description": "Nombre legible, p. ej. `azul marino`."
        },
        "near_face": {
          "type": "boolean",
          "description": "`true` si queda cerca de la cara (cuello, parte alta); pesa más en colorimetría."
        }
      },
      "required": [
        "lab",
        "hex",
        "proportion"
      ],
      "additionalProperties": false,
      "description": "Un color dominante de la prenda."
    },
    "LabColor": {
      "type": "object",
      "properties": {
        "l": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "a": {
          "type": "number",
          "minimum": -128,
          "maximum": 127
        },
        "b": {
          "type": "number",
          "minimum": -128,
          "maximum": 127
        }
      },
      "required": [
        "l",
        "a",
        "b"
      ],
      "additionalProperties": false,
      "description": "Color CIELAB (iluminante D65, observador 2°)."
    },
    "HexColor": {
      "type": "string",
      "description": "Color sRGB en hexadecimal, `#RRGGBB`.",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "DesignFit": {
      "type": "string",
      "enum": [
        "slim",
        "regular",
        "relaxed",
        "oversize"
      ],
      "description": "Fit con el que se diseñó la prenda (no confundir con llevar una talla mayor)."
    },
    "GarmentSizeMeasurements": {
      "type": "object",
      "properties": {
        "size_label": {
          "type": "string",
          "description": "Etiqueta de talla tal como la escribe la marca: `M`, `40`, `32/34`."
        },
        "zones": {
          "$ref": "#/definitions/ZoneMeasurements"
        },
        "source": {
          "$ref": "#/definitions/GarmentMeasurementSource"
        }
      },
      "required": [
        "size_label",
        "zones",
        "source"
      ],
      "additionalProperties": false,
      "description": "Medidas de una prenda en una talla concreta (fila de `garment_measurements`)."
    },
    "ZoneMeasurements": {
      "type": "object",
      "properties": {
        "neck": {
          "$ref": "#/definitions/Centimeters"
        },
        "shoulder": {
          "$ref": "#/definitions/Centimeters"
        },
        "chest": {
          "$ref": "#/definitions/Centimeters"
        },
        "waist": {
          "$ref": "#/definitions/Centimeters"
        },
        "hip": {
          "$ref": "#/definitions/Centimeters"
        },
        "sleeve_length": {
          "$ref": "#/definitions/Centimeters"
        },
        "bicep": {
          "$ref": "#/definitions/Centimeters"
        },
        "body_length": {
          "$ref": "#/definitions/Centimeters"
        },
        "thigh": {
          "$ref": "#/definitions/Centimeters"
        },
        "inseam": {
          "$ref": "#/definitions/Centimeters"
        },
        "rise": {
          "$ref": "#/definitions/Centimeters"
        },
        "hem": {
          "$ref": "#/definitions/Centimeters"
        }
      },
      "additionalProperties": false,
      "description": "Medidas de una prenda por zona, en cm."
    },
    "GarmentMeasurementSource": {
      "type": "string",
      "enum": [
        "brand_size_chart",
        "photo_reference_object",
        "lidar",
        "manual",
        "estimated"
      ]
    },
    "GarmentLevel": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "description": "1 = plantilla paramétrica + textura; 2 = patrón desde foto; 3 = 3D nativo de marca."
    },
    "DrapeJobOutput": {
      "type": "object",
      "properties": {
        "glb_url": {
          "$ref": "#/definitions/Url",
          "description": "GLB de la prenda ya drapeada, en el mismo sistema de coordenadas que el avatar."
        },
        "cache_key": {
          "type": "string",
          "description": "hash(shape_hash, garment_id, versión de prenda, talla, pose, calidad, versión del simulador)."
        },
        "cache_hit": {
          "type": "boolean",
          "description": "`true` si salió de `drape_cache` sin simular."
        },
        "fit_result": {
          "$ref": "#/definitions/FitResult"
        }
      },
      "required": [
        "glb_url",
        "cache_key",
        "cache_hit"
      ],
      "additionalProperties": false,
      "description": "Salida del job `drape`."
    },
    "FitResult": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/UUID"
        },
        "avatar_id": {
          "$ref": "#/definitions/UUID"
        },
        "garment_id": {
          "$ref": "#/definitions/UUID"
        },
        "size_label": {
          "type": "string"
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ZoneFit"
          },
          "minItems": 1
        },
        "verdict": {
          "$ref": "#/definitions/FitVerdict"
        },
        "effective_fit": {
          "$ref": "#/definitions/DesignFit",
          "description": "Cómo queda de verdad en este cuerpo, que puede no coincidir con `design_fit`."
        },
        "matches_design_fit": {
          "type": "boolean",
          "description": "`false` cuando, p. ej., un oversize de diseño queda regular o una talla mayor finge oversize."
        },
        "score": {
          "$ref": "#/definitions/UnitInterval",
          "description": "Ajuste respecto a las preferencias del usuario; entra en el ranking con peso 0,3."
        },
        "recommended_size_label": {
          "type": "string",
          "description": "Talla recomendada si no es `size_label`."
        },
        "method": {
          "$ref": "#/definitions/FitMethod"
        },
        "confidence": {
          "$ref": "#/definitions/UnitInterval"
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        }
      },
      "required": [
        "id",
        "avatar_id",
        "garment_id",
        "size_label",
        "zones",
        "verdict",
