            }
          ],
          "description": "Momento en que la API borró las fotos de entrada de `raw-uploads`. Lo escribe solo la API (el worker no puede borrar ni lo declara). `null` mientras no se hayan borrado o si el job no tiene fotos (drapeado)."
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "user_id",
        "type",
        "status",
        "progress",
        "input",
        "output",
        "error",
        "attempts",
        "fake",
        "input_deleted_at",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "DrapeJobInput": {
      "type": "object",
      "properties": {
        "avatar_id": {
          "$ref": "#/definitions/UUID"
        },
        "garment_id": {
          "$ref": "#/definitions/UUID"
        },
        "size_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "pose": {
          "$ref": "#/definitions/AvatarPose"
        },
        "quality": {
          "$ref": "#/definitions/DrapeQuality"
        }
      },
      "required": [
        "avatar_id",
        "garment_id",
        "size_label",
        "pose",
        "quality"
      ],
      "additionalProperties": false,
      "description": "Entrada del job `drape` tal como la envía la app: solo identificadores. La API resuelve lo que el simulador necesita y lo añade al despacho en `DrapeJobDispatch.context`."
    },
    "AvatarPose": {
      "type": "string",
      "enum": [
        "a_pose",
        "t_pose",
        "relaxed"
      ]
    },
    "DrapeQuality": {
      "type": "string",
      "enum": [
        "preview",
        "final"
      ]
    },
    "DrapeJobResult": {
      "type": "object",
      "properties": {
        "drape_cache_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ],
          "description": "Entrada de `drape_cache` creada o reutilizada; `null` si el avatar o la prenda se borraron antes."
        },
        "fit_result_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_hit": {
          "type": "boolean",
          "description": "`true` si salió de `drape_cache` sin simular."
        }
      },
      "required": [
        "drape_cache_id",
        "fit_result_id",
        "cache_hit"
      ],
      "additionalProperties": false
    },
