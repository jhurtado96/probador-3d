{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "job": {
      "$ref": "#/definitions/Job"
    },
    "uploads": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UploadTicket"
      },
      "description": "Vacío si no hay nada que subir (drapeado, o fotos ya subidas): el job ya está despachado."
    }
  },
  "required": [
    "job",
    "uploads"
  ],
  "additionalProperties": false,
  "description": "Respuesta 201 de `POST /functions/v1/create-job`.",
  "definitions": {
    "Job": {
      "anyOf": [
        {
          "$ref": "#/definitions/AvatarJob"
        },
        {
          "$ref": "#/definitions/GarmentJob"
        },
        {
          "$ref": "#/definitions/DrapeJob"
        },
        {
          "$ref": "#/definitions/ColorJob"
        }
      ],
      "description": "Fila de `jobs`. Unión discriminada por `type`."
    },
    "AvatarJob": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/UUID"
        },
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dueño. `null` en jobs de ingesta de catálogo."
        },
        "type": {
          "type": "string",
          "const": "avatar"
        },
        "status": {
          "$ref": "#/definitions/JobStatus"
        },
        "progress": {
          "$ref": "#/definitions/UnitInterval",
          "description": "Avance aproximado, para la barra de progreso."
        },
        "stage": {
          "type": "string",
          "description": "Etapa actual legible por máquina: `segmenting`, `fitting`, `exporting`…"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/AvatarJobInput"
            },
            {
              "$ref": "#/definitions/RetainedJobInput"
            }
          ],
          "description": "Entrada completa mientras el job está en cola o en curso; `RetainedJobInput` al terminar."
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/AvatarJobResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "Presente solo si `status` es `succeeded`: referencias a lo creado, nunca el objeto completo."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Presente solo si `status` es `failed`."
        },
        "attempts": {
          "type": "integer",
          "description": "Intentos consumidos.",
          "minimum": 0
        },
        "worker_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Versión del worker que lo procesó."
        },
        "fake": {
          "type": "boolean",
          "description": "`true` si el resultado lo generó un worker en modo fake: los datos derivados son de pega y no deben mostrarse como reales."
        },
        "input_deleted_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Momento en que la API borró las fotos de entrada de `raw-uploads`. Lo escribe solo la API (el worker no puede borrar ni lo declara). `null` mientras no se hayan borrado o si el job no tiene fotos (drapeado)."
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "user_id",
        "type",
        "status",
        "progress",
        "input",
        "output",
        "error",
        "attempts",
        "fake",
        "input_deleted_at",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "UUID": {
      "type": "string",
      "description": "Identificador UUID.",
      "format": "uuid"
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ]
    },
    "UnitInterval": {
      "type": "number",
      "description": "Valor normalizado entre 0 y 1.",
      "minimum": 0,
      "maximum": 1
    },
    "AvatarJobInput": {
      "type": "object",
      "properties": {
        "photo_path": {
          "$ref": "#/definitions/StoragePath",
          "description": "Foto de cuerpo entero en el bucket efímero. Se borra al terminar el job."
        },
        "height_cm": {
          "type": "number",
          "minimum": 50,
          "maximum": 260
        },
        "weight_kg": {
          "type": "number",
          "minimum": 20,
          "maximum": 350
        },
        "gender": {
          "$ref": "#/definitions/BodyModelGender"
        },
        "consent_id": {
          "$ref": "#/definitions/UUID",
          "description": "Consentimiento vigente que ampara este tratamiento."
        }
      },
      "required": [
        "photo_path",
        "height_cm",
        "consent_id"
      ],
      "additionalProperties": false,
      "description": "Entrada del job `avatar`."
    },
    "StoragePath": {
      "type": "string",
      "description": "Ruta de un objeto en Storage, `bucket/carpeta/fichero`.",
      "minLength": 3
    },
    "BodyModelGender": {
      "type": "string",
      "enum": [
        "neutral",
        "female",
        "male"
      ]
    },
    "RetainedJobInput": {
      "type": "object",
      "properties": {
        "consent_id": {
          "$ref": "#/definitions/UUID"
        },
        "avatar_id": {
          "$ref": "#/definitions/UUID"
        },
        "garment_id": {
          "$ref": "#/definitions/UUID"
        }
      },
      "additionalProperties": false,
      "description": "Lo que queda de `jobs.input` cuando el job termina (o se cancela): solo los identificadores. Altura, peso, género y rutas de fotos se purgan al cerrar el job; retirar el consentimiento o borrar el avatar, el perfil de color o la prenda quita también su id. La API purga los jobs terminados a los 30 días."
    },
    "AvatarJobResult": {
      "type": "object",
      "properties": {
        "avatar_id": {
          "$ref": "#/definitions/UUID"
        }
      },
      "required": [
        "avatar_id"
      ],
      "additionalProperties": false,
      "description": "Lo que `jobs.output` conserva de un job terminado con éxito: solo referencias a lo que se creó (minimización, art. 5.1.c y 5.1.e RGPD). El objeto de dominio completo (avatar con medidas, perfil de color…) vive solo en su tabla y se borra con ella; `jobs` no guarda copias."
    },
    "JobError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/JobErrorCode"
        },
        "message": {
          "type": "string",
          "description": "Mensaje técnico para logs; la app traduce `code`, no muestra esto."
        },
        "retryable": {
          "type": "boolean",
          "description": "Si tiene sentido reintentar sin cambiar la entrada."
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "JobErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "no_person_detected",
        "multiple_people",
        "pose_invalid",
        "body_not_fully_visible",
        "no_face_detected",
        "white_reference_missing",
        "garment_not_detected",
        "person_detected",
        "low_image_quality",
        "consent_missing",
        "quota_exceeded",
        "not_implemented",
        "timeout",
        "internal"
      ],
      "description": "Motivo por el que falla un job. `person_detected`: en una foto de prenda aparece una persona (piel o cara); el worker no sube ningún recorte y la foto se borra igualmente. `not_implemented`: el worker aún no tiene pipeline real para ese tipo (no reintentar). `quota_exceeded`: se agotó una cuota (del usuario o del proveedor de GPU)."
    },
    "ISODateTime": {
      "type": "string",
      "description": "Fecha y hora ISO 8601 en UTC.",
      "format": "date-time"
    },
    "GarmentJob": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/UUID"
        },
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/UUID"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dueño. `null` en jobs de ingesta de catálogo."
        },
        "type": {
          "type": "string",
          "const": "garment"
        },
        "status": {
          "$ref": "#/definitions/JobStatus"
        },
        "progress": {
          "$ref": "#/definitions/UnitInterval",
          "description": "Avance aproximado, para la barra de progreso."
        },
        "stage": {
          "type": "string",
          "description": "Etapa actual legible por máquina: `segmenting`, `fitting`, `exporting`…"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/GarmentJobInput"
            },
            {
              "$ref": "#/definitions/RetainedJobInput"
            }
          ],
          "description": "Entrada completa mientras el job está en cola o en curso; `RetainedJobInput` al terminar."
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/GarmentJobResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "Presente solo si `status` es `succeeded`: referencias a lo creado, nunca el objeto completo."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Presente solo si `status` es `failed`."
        },
        "attempts": {
          "type": "integer",
          "description": "Intentos consumidos.",
          "minimum": 0
        },
        "worker_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Versión del worker que lo procesó."
        },
        "fake": {
          "type": "boolean",
          "description": "`true` si el resultado lo generó un worker en modo fake: los datos derivados son de pega y no deben mostrarse como reales."
        },
        "input_deleted_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Momento en que la API borró las fotos de entrada de `raw-uploads`. Lo escribe solo la API (el worker no puede borrar ni lo declara). `null` mientras no se hayan borrado o si el job no tiene fotos (drapeado)."
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "user_id",
        "type",
        "status",
        "progress",
        "input",
        "output",
        "error",
        "attempts",
        "fake",
        "input_deleted_at",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "GarmentJobInput": {
      "type": "object",
      "properties": {
        "garment_id": {
          "$ref": "#/definitions/UUID",
          "description": "Prenda ya creada con `status: processing` que este job rellena."
        },
        "image_paths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StoragePath"
          },
          "description": "Fotos de la prenda en el bucket efímero.",
          "minItems": 1,
          "maxItems": 6
        },
        "category_hint": {
          "$ref": "#/definitions/GarmentCategory"
        },
        "size_label": {
          "type": "string",
          "maxLength": 32
        },
        "brand": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "garment_id",
        "image_paths"
      ],
      "additionalProperties": false,
      "description": "Entrada del job `garment`."
    },
    "GarmentCategory": {
      "type": "string",
      "enum": [
        "tshirt",
        "shirt",
        "sweater",
        "hoodie",
        "jacket",
        "coat",
        "dress",
        "skirt",
        "pants",
        "jeans",
        "shorts"
      ]
    },
    "GarmentJobResult": {
      "type": "object",
      "properties": {
        "garment_id": {
          "$ref": "#/definitions/UUID"
        }
      },
      "required": [
        "garment_id"
      ],
      "additionalProperties": false
    },
    "DrapeJob": {
      "type": "object",
      "properties": {
        "id": {
