            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Momento en que la API borró las fotos de entrada de `raw-uploads`. Lo escribe solo la API (el worker no puede borrar ni lo declara). `null` mientras no se hayan borrado o si el job no tiene fotos (drapeado)."
        },
        "created_at": {
          "$ref": "#/definitions/ISODateTime"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/ISODateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "user_id",
        "type",
        "status",
        "progress",
        "input",
        "output",
        "error",
        "attempts",
        "fake",
        "input_deleted_at",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "ColorJobInput": {
      "type": "object",
      "properties": {
        "selfie_path": {
          "$ref": "#/definitions/StoragePath",
          "description": "Selfie en el bucket efímero. Se borra al terminar el job."
        },
        "white_reference": {
          "$ref": "#/definitions/WhiteReference"
        },
        "consent_id": {
          "$ref": "#/definitions/UUID"
        }
      },
      "required": [
        "selfie_path",
        "white_reference",
        "consent_id"
      ],
      "additionalProperties": false,
      "description": "Entrada del job `color`."
    },
    "WhiteReference": {
      "type": "string",
      "enum": [
        "paper",
        "gray_card",
        "none"
      ]
    },
    "ColorJobResult": {
      "type": "object",
      "properties": {
        "color_profile_id": {
          "$ref": "#/definitions/UUID"
        }
      },
      "required": [
        "color_profile_id"
      ],
      "additionalProperties": false
    },
    "UploadTicket": {
      "type": "object",
